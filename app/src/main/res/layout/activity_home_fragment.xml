<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gambar">

    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/bg_wave_home" />

    <!-- 🛠️ PERBAIKAN 1: Mengubah ScrollView menjadi androidx.core.widget.NestedScrollView -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="80dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="35dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selamat Datang,"
                        android:textColor="#CCFFFFFF"
                        android:textSize="14sp"
                        android:letterSpacing="0.05"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Layanan Desa"
                        android:textColor="@color/white"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:shadowColor="#40000000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="4"/>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    app:cardCornerRadius="25dp"
                    app:cardBackgroundColor="#4DFFFFFF"
                    app:strokeWidth="0dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/logo_bina_desa"
                        android:padding="8dp"
                        android:contentDescription="Logo" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KATEGORI SURAT"
                android:textColor="#D9FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupLayanan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSemua"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Semua"
                    android:checked="true"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="#4D0B0B0B"
                    app:checkedIconVisible="true"
                    app:checkedIconTint="@color/white" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipKependudukan"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kependudukan"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="#4D0B0B0B"
                    app:checkedIconVisible="true"
                    app:checkedIconTint="@color/white" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBansos"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bansos"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="#4D0B0B0B"
                    app:checkedIconVisible="true"
                    app:checkedIconTint="@color/white" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#F2FFFFFF"
                app:cardCornerRadius="28dp"
                app:cardElevation="15dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:letterSpacing="0.1"
                        android:text="LAYANAN UTAMA"
                        android:textColor="#9E9E9E"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWebView"
                        android:layout_width="match_parent"
                        android:layout_height="65dp"
                        android:layout_marginBottom="16dp"
                        android:backgroundTint="#1A237E"
                        android:text="Portal Web Bina Desa"
                        android:textAllCaps="false"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="18dp"
                        app:icon="@android:drawable/ic_menu_agenda"
                        app:iconGravity="textStart"
                        app:iconPadding="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAjukanSurat"
                        android:layout_width="match_parent"
                        android:layout_height="65dp"
                        android:layout_marginBottom="20dp"
                        android:backgroundTint="#2196F3"
                        android:text="Ajukan Surat Baru"
                        android:textAllCaps="false"
                        android:textSize="16sp"
                        app:cornerRadius="18dp"
                        app:icon="@android:drawable/ic_menu_sort_by_size"
                        app:iconGravity="textStart"
                        app:iconPadding="16dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginBottom="20dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:letterSpacing="0.1"
                        android:text="LAYANAN MANDIRI"
                        android:textColor="#9E9E9E"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSuratMandiri"
                            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                            android:layout_width="0dp"
                            android:layout_height="100dp"
                            android:layout_columnWeight="1"
                            android:layout_marginEnd="8dp"
                            android:layout_marginBottom="16dp"
                            android:backgroundTint="#E8F5E9"
                            android:text="Buat Surat"
                            android:textAllCaps="false"
                            android:textColor="#2E7D32"
                            app:cornerRadius="20dp"
                            app:icon="@android:drawable/ic_menu_edit"
                            app:iconGravity="top"
                            app:iconPadding="8dp"
                            app:iconTint="#2E7D32" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStatusSurat"
                            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                            android:layout_width="0dp"
                            android:layout_height="100dp"
                            android:layout_columnWeight="1"
                            android:layout_marginStart="8dp"
                            android:layout_marginBottom="16dp"
                            android:backgroundTint="#FFF3E0"
                            android:text="Status Surat"
                            android:textAllCaps="false"
                            android:textColor="#E65100"
                            app:cornerRadius="20dp"
                            app:icon="@android:drawable/ic_menu_info_details"
                            app:iconGravity="top"
                            app:iconPadding="8dp"
                            app:iconTint="#E65100" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCustom1"
                            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                            android:layout_width="0dp"
                            android:layout_height="100dp"
                            android:layout_columnWeight="1"
                            android:layout_marginEnd="8dp"
                            android:backgroundTint="#F0F4C3"
                            android:text="Profil Desa"
                            android:textAllCaps="false"
                            android:textColor="#827717"
                            app:cornerRadius="20dp"
                            app:icon="@android:drawable/ic_menu_myplaces"
                            app:iconGravity="top"
                            app:iconPadding="8dp"
                            app:iconTint="#827717" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCustom2"
                            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                            android:layout_width="0dp"
                            android:layout_height="100dp"
                            android:layout_columnWeight="1"
                            android:layout_marginStart="8dp"
                            android:backgroundTint="#E1BEE7"
                            android:text="Bantuan"
                            android:textAllCaps="false"
                            android:textColor="#7B1FA2"
                            app:cornerRadius="20dp"
                            app:icon="@android:drawable/ic_menu_send"
                            app:iconGravity="top"
                            app:iconPadding="8dp"
                            app:iconTint="#7B1FA2" />
                    </GridLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#F2FFFFFF"
                app:cardCornerRadius="28dp"
                app:cardElevation="10dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:letterSpacing="0.1"
                        android:text="FORM PENGAJUAN CEPAT"
                        android:textColor="#9E9E9E"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="NIK Anda"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:startIconDrawable="@android:drawable/ic_menu_edit">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNikSurat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:hint="Alasan Pengajuan"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAlasanSurat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:lines="3" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSubmitSurat"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Kirim Pengajuan"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:backgroundTint="#1B5E20" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#F2FFFFFF"
                app:cardCornerRadius="28dp"
                app:cardElevation="10dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:letterSpacing="0.1"
                        android:text="PUSAT INFORMASI"
                        android:textColor="#9E9E9E"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ListView
                        android:id="@+id/listViewInfo"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:divider="#EEEEEE"
                        android:dividerHeight="1dp"
                        android:nestedScrollingEnabled="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- KARTU BERITA PUBLIC -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#F2FFFFFF"
                app:cardCornerRadius="28dp"
                app:cardElevation="10dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:letterSpacing="0.1"
                        android:text="BERITA PUBLIK TERKINI"
                        android:textColor="#9E9E9E"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- 🛠️ PERBAIKAN 2: Mengubah height ke wrap_content agar RecyclerView
                         menyesuaikan jumlah item berita dan mengalir bersama NestedScrollView -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvNews"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:text="Keluar dari Akun"
                android:textAllCaps="false"
                android:textColor="#E53935"
                app:cornerRadius="16dp"
                app:strokeColor="#E53935"
                app:strokeWidth="1.5dp"
                app:icon="@android:drawable/ic_lock_power_off"
                app:iconTint="#E53935"
                app:iconGravity="textStart" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:columnCount="3">
                <TextView
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:text="Versi 2.0"
                    android:textColor="#80FFFFFF"
                    android:textSize="10sp" />
                <TextView
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:text="Layanan Desa © 2026"
                    android:textColor="#80FFFFFF"
                    android:textSize="10sp" />
                <TextView
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:text="Kec. Maju Jaya"
                    android:textColor="#80FFFFFF"
                    android:textSize="10sp" />
            </GridLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
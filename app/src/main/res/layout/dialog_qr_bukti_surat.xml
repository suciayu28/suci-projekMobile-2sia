<?xml version="1.0" encoding="utf-8"?>
<!--
    PERTEMUAN 13: Dialog popup menampilkan QR Code bukti surat
    Muncul ketika pengguna menekan "Lihat QR Bukti Surat" pada riwayat surat Selesai.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔲 QR Bukti Surat"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/bina_desa_blue"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvNomorSuratDialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SRT001"
        android:textSize="13sp"
        android:textColor="#64748B"
        android:layout_marginBottom="20dp" />

    <!-- QR Code Image -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="220dp"
        android:layout_height="220dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:strokeWidth="1dp"
        app:strokeColor="#E2E8F0"
        app:cardBackgroundColor="@android:color/white">
        <ImageView
            android:id="@+id/ivQrDialog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:contentDescription="QR Code Bukti Surat" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Tunjukkan QR ini saat mengambil surat di kantor desa."
        android:textSize="12sp"
        android:textColor="#94A3B8"
        android:gravity="center" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTutupDialog"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="20dp"
        android:text="Tutup"
        android:textAllCaps="false"
        android:textStyle="bold"
        app:cornerRadius="10dp"
        app:backgroundTint="@color/bina_desa_blue" />

</LinearLayout>

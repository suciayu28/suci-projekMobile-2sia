<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F9FF"
    android:padding="24dp">

    <!-- ELEMEN DEKORASI ATAS (Diperhalus menjadi lingkaran modern) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="-80dp"
        android:layout_marginEnd="-80dp"
        android:alpha="0.4"
        app:cardBackgroundColor="#BAE6FD"
        app:cardCornerRadius="130dp"
        app:strokeWidth="0dp"
        app:cardElevation="0dp" />

    <!-- KARTU UTAMA MELAYANG (Desain Minimalis & Smooth Shadow) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMain1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="32dp"
        app:cardElevation="12dp"
        app:strokeWidth="1dp"
        app:strokeColor="#E0F2FE">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingVertical="40dp">

            <!-- AREA ILUSTRASI GAMBAR (Dibuat lingkaran bergradasi lembut) -->
            <FrameLayout
                android:layout_width="160dp"
                android:layout_height="160dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="#E0F2FE"
                    app:cardCornerRadius="80dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    android:alpha="0.6"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    app:cardBackgroundColor="#0284C7"
                    app:cardCornerRadius="60dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/imgOnboarding1"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_myplaces"
                        android:contentDescription="Ilustrasi Layanan Mandiri"
                        app:tint="#FFFFFF" />
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <!-- JUDUL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Layanan Mandiri Desa"
                android:textColor="#0F172A"
                android:textSize="26sp"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold"
                android:gravity="center"/>

            <!-- DEKORASI GARIS BAWAH JUDUL -->
            <View
                android:layout_width="48dp"
                android:layout_height="5dp"
                android:layout_marginTop="16dp"
                android:background="#0284C7"
                android:backgroundTint="#0284C7" />

            <!-- DESKRIPSI (Tipografi lebih renggang & nyaman dibaca) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingHorizontal="12dp"
                android:text="Nikmati kemudahan akses administrasi kependudukan dan layanan publik desa secara mandiri langsung dari ponsel Anda."
                android:textColor="#475569"
                android:textSize="15sp"
                android:fontFamily="sans-serif"
                android:lineSpacingMultiplier="1.4"
                android:gravity="center" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ELEMEN DEKORASI BAWAH (Diperhalus menjadi lingkaran modern) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginBottom="-60dp"
        android:layout_marginStart="-60dp"
        android:alpha="0.3"
        app:cardBackgroundColor="#BAE6FD"
        app:cardCornerRadius="90dp"
        app:strokeWidth="0dp"
        app:cardElevation="0dp" />

</RelativeLayout>